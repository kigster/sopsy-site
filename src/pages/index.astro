---
import Base from "../layouts/Base.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import FinalCta from "../components/FinalCta.astro";
import { anchorRedirects } from "../routes";
---

<Base>
  <!-- The site used to be one long page. Send old /#section links to the
       route that now holds that section, before anything paints. -->
  <script is:inline slot="head" define:vars={{ anchorRedirects }}>
    (function () {
      var to = anchorRedirects[location.hash.slice(1)];
      if (to) location.replace(to);
    })();
  </script>
  <FlowDiagram />
  <Hero />
  <Marquee />
  <FinalCta />
</Base>
