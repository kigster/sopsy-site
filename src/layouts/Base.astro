---
import "../styles/global.css";
// Print rules live in their own @media print block, so every page prints as docs.
import "../styles/print.css";
import { ClientRouter, fade } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. /print duplicates every route). */
  noindex?: boolean;
}

const {
  title = "sopsy — encrypted team secrets in Git, unlocked with Touch ID or a YubiKey",
  description = "A Rust CLI that keeps your team's API keys and .env secrets encrypted in Git. Hardware keys in the macOS Secure Enclave or a YubiKey, a key-store policy per repository, secrets passed straight to your app with no plaintext on disk, self-service onboarding, and a CI gate that blocks plaintext leaks. Built on SOPS + age.",
  noindex = false,
} = Astro.props;

// Social previews (LinkedIn, X, Slack, iMessage…) only accept absolute URLs.
// The card is rendered from docs/social/card.html by bin/social-cards.
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(
  `${import.meta.env.BASE_URL}social/sopsy-2-og.png`,
  site,
).href;
const ogImageAlt =
  "sopsy 2.0: Any key store. Fewer prompts. No plaintext on disk. Team secrets encrypted in Git, keys in the Secure Enclave or on a YubiKey.";
---

<!doctype html>
<!-- Page changes cross-fade; Astro skips the animation under prefers-reduced-motion. -->
<html lang="en" transition:animate={fade({ duration: "0.25s" })}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      async
      is:inline
      src="https://www.googletagmanager.com/gtag/js?id=G-Y4SN28QGC3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-Y4SN28QGC3");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Set the theme before first paint so there is no flash. Dark is the
         default; a stored choice (if any) wins. We intentionally do NOT follow
         prefers-color-scheme, to keep dark as the default experience. -->
    <script is:inline>
      (function () {
        function apply() {
          var t;
          try {
            t = localStorage.getItem("sopsy-theme");
          } catch (e) {}
          if (t !== "light" && t !== "dark") t = "dark";
          document.documentElement.setAttribute("data-theme", t);
        }
        apply();
        // A client-side navigation replaces <html>'s attributes with the new
        // page's, which carry no theme: put the stored one back before paint.
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="sopsy" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#121318" />

    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
      type="image/svg+xml"
    />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap.xml`} />

    <!-- Fonts: Inter (display) · Nunito (body) · JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <script>
      // With the client router this module runs once per full page load.
      // The nav and the theme toggle live in the persisted header, so they are
      // bound once here; anything inside the swapped content is bound again on
      // every astro:page-load.

      // Analytics — thin wrapper around gtag so the rest of the script can
      // fire events without caring whether GA loaded (ad-blocked, offline…).
      const track = (name: string, params: Record<string, unknown> = {}) => {
        (window as any).gtag?.("event", name, params);
      };

      // Top-nav clicks — so we learn which nav items drive engagement.
      document.querySelectorAll<HTMLAnchorElement>(".nav a").forEach((a) => {
        a.addEventListener("click", () => {
          track("nav_click", {
            link_text: (a.textContent ?? "").trim(),
            link_url: a.getAttribute("href") ?? "",
          });
        });
      });

      // Theme toggle — dark is the default; the chosen theme persists in
      // localStorage. The initial data-theme is already set by the inline
      // head script above, so there is no flash on load.
      const root = document.documentElement;
      const themeBtn = document.getElementById("theme-toggle");
      const syncTheme = (t: string) => {
        themeBtn?.setAttribute(
          "aria-label",
          t === "light" ? "Switch to dark theme" : "Switch to light theme",
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", t === "light" ? "#faf7f1" : "#121318");
      };
      themeBtn?.addEventListener("click", () => {
        const next =
          root.getAttribute("data-theme") === "light" ? "dark" : "light";
        if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          root.classList.add("theme-anim");
          setTimeout(() => root.classList.remove("theme-anim"), 360);
        }
        root.setAttribute("data-theme", next);
        track("changeColor", { theme: next });
        try {
          localStorage.setItem("sopsy-theme", next);
        } catch {
          /* storage unavailable — toggle still works for the session */
        }
        syncTheme(next);
      });

      // Mobile nav — the hamburger toggles the collapsed link dropdown.
      const burger = document.getElementById("nav-burger");
      const menu = document.getElementById("nav-menu");
      const setOpen = (open: boolean) => {
        menu?.classList.toggle("is-open", open);
        burger?.setAttribute("aria-expanded", String(open));
      };
      if (burger && menu) {
        const isOpen = () => menu.classList.contains("is-open");
        burger.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = !isOpen();
          setOpen(open);
          // The links come before the burger in the DOM, so Tab alone would
          // skip them: move focus into the menu when it opens.
          if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            setOpen(false);
            burger.focus();
          }
        });
        // Close once keyboard focus leaves both the menu and the burger.
        menu.addEventListener("focusout", (e) => {
          const next = e.relatedTarget as Node | null;
          if (next && !menu.contains(next) && !burger.contains(next))
            setOpen(false);
        });
        document.addEventListener("click", (e) => {
          const t = e.target as Node;
          if (!menu.contains(t) && !burger.contains(t)) setOpen(false);
        });
      }

      // Desktop dropdowns in the nav (Guide). Under the hamburger the toggle is
      // hidden and its links show as plain rows, so this only matters wide.
      const drops = [...document.querySelectorAll<HTMLElement>(".nav__group")];
      const setDrop = (g: HTMLElement, open: boolean) => {
        g.classList.toggle("is-open", open);
        g.querySelector(".nav__drop")?.setAttribute(
          "aria-expanded",
          String(open),
        );
      };
      const closeDrops = () => drops.forEach((g) => setDrop(g, false));
      drops.forEach((g) => {
        const btn = g.querySelector<HTMLButtonElement>(".nav__drop")!;
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = !g.classList.contains("is-open");
          closeDrops();
          setDrop(g, open);
        });
        g.addEventListener("keydown", (e) => {
          const links = [...g.querySelectorAll<HTMLAnchorElement>("a")];
          const i = links.indexOf(document.activeElement as HTMLAnchorElement);
          if (e.key === "Escape" && g.classList.contains("is-open")) {
            e.stopPropagation(); // don't also close the mobile menu
            setDrop(g, false);
            btn.focus();
          } else if (e.key === "ArrowDown") {
            e.preventDefault();
            setDrop(g, true);
            links[(i + 1) % links.length]?.focus();
          } else if (e.key === "ArrowUp" && i >= 0) {
            e.preventDefault();
            links[(i - 1 + links.length) % links.length]?.focus();
          }
        });
        g.addEventListener("focusout", (e) => {
          const next = e.relatedTarget as Node | null;
          if (next && !g.contains(next)) setDrop(g, false);
        });
      });
      document.addEventListener("click", (e) => {
        drops.forEach((g) => {
          if (!g.contains(e.target as Node)) setDrop(g, false);
        });
      });

      // Scroll reveal — progressively reveals sections + staggered child rows.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("is-in");
            const kids = e.target.querySelectorAll<HTMLElement>(".checkitem");
            kids.forEach((k, i) => (k.style.animationDelay = `${i * 70}ms`));
            io.unobserve(e.target);
          }
        },
        { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
      );
      document.addEventListener("astro:before-swap", () => io.disconnect());

      // Everything below runs for each page, the first one included.
      document.addEventListener("astro:page-load", () => {
        setOpen(false);
        syncTheme(root.getAttribute("data-theme") ?? "dark");

        // The nav is persisted, so mark the current route here as well.
        const here = location.pathname.replace(/\/$/, "");
        document
          .querySelectorAll<HTMLAnchorElement>("#nav-menu a")
          .forEach((a) => {
            const url = new URL(a.href);
            // a #hash link (Demo) points into a page, it is not the page
            const on = !url.hash && url.pathname.replace(/\/$/, "") === here;
            if (on) a.setAttribute("aria-current", "page");
            else a.removeAttribute("aria-current");
          });
        // a dropdown is "current" when one of its links is
        document.querySelectorAll(".nav__group").forEach((g) => {
          g.querySelector(".nav__drop")?.classList.toggle(
            "is-current",
            !!g.querySelector('a[aria-current="page"]'),
          );
        });
        closeDrops();

        document
          .querySelectorAll("[data-reveal], .checklist")
          .forEach((el) => io.observe(el));

        // Copy-to-clipboard for install / command fields.
        document
          .querySelectorAll<HTMLButtonElement>("main [data-copy]")
          .forEach((btn) => {
            btn.addEventListener("click", async () => {
              try {
                const cmd = btn.dataset.copy ?? "";
                track("copy_command", {
                  command: cmd,
                  location: btn.closest("[id]")?.id ?? "unknown",
                });
                await navigator.clipboard.writeText(cmd);
                const prev = btn.textContent;
                btn.textContent = "copied ✓";
                btn.classList.add("copied");
                setTimeout(() => {
                  btn.textContent = prev;
                  btn.classList.remove("copied");
                }, 1600);
              } catch {
                /* clipboard unavailable — no-op */
              }
            });
          });
      });
    </script>
  </body>
</html>
