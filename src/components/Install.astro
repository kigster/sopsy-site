---
import { SOPSY_VERSION } from "../constants";

// Two install paths plus the optional tap-trust step, lifted from
// ../sopsy/README.md "Install".
const methods = [
  {
    name: "Homebrew",
    tag: "recommended",
    rec: true,
    cmds: ["brew install kigster/tap/sopsy"],
    body: "Installs a <b>prebuilt binary</b> — no Rust toolchain — and pulls the tools sopsy orchestrates (<code>sops</code>, <code>age</code>, and <code>age-plugin-se</code>) automatically. <code>sopsy deps</code> adds the YubiKey tools when you need them.",
  },
  {
    name: "From crates.io",
    tag: "requires Rust",
    rec: false,
    cmds: ["cargo install sopsy"],
    body: "Builds from source with Cargo. You'll still need <code>sops</code>, <code>age</code>, and <code>age-plugin-se</code> on your <code>PATH</code> — or run <code>sopsy deps</code> to fetch them, along with <code>age-plugin-yubikey</code> and <code>ykman</code>. <code>sopsy init</code> runs the same step first.",
  },
  {
    name: "Tap trust",
    tag: "only if required",
    rec: false,
    wide: true,
    cmds: [
      "brew trust --tap kigster/tap",
      "brew trust --formula kigster/tap/sopsy",
    ],
    body: "Only when your Homebrew sets <code>HOMEBREW_REQUIRE_TAP_TRUST</code>: trust the tap and the formula once before installing, and re-run <code>brew trust --formula kigster/tap/sopsy</code> before each <code>brew upgrade sopsy</code>.",
  },
];
---

<section class="section" id="install">
  <div class="container">
    <div data-reveal style="margin-bottom: 2.5rem; max-width: 80ch">
      <p class="eyebrow">Install</p>
      <h2 class="section-title">Up and running in one command.</h2>
    </div>

    <div class="install__grid" data-reveal>
      {
        methods.map((m) => (
          <article
            class={`install__card${m.wide ? " install__card--wide" : ""}`}
          >
            <div class="install__head">
              <h3>{m.name}</h3>
              <span class={`install__tag${m.rec ? " install__tag--rec" : ""}`}>
                {m.tag}
              </span>
            </div>
            {m.cmds.map((cmd) => (
              <div class="copyfield">
                <span class="sigil">$</span>
                <span>{cmd}</span>
                <button data-copy={cmd} aria-label={`Copy: ${cmd}`}>
                  copy
                </button>
              </div>
            ))}
            <p class="install__body">
              <Fragment set:html={m.body} />
            </p>
          </article>
        ))
      }
    </div>

    <p class="install__note" data-reveal>
      <span class="lime">●</span>
      macOS-first (v{SOPSY_VERSION}). Homebrew installs the prebuilt binary and
      every prerequisite; the Cargo path needs the Rust toolchain.
    </p>
  </div>
</section>
