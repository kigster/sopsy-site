---
import { SOPSY_VERSION } from "../constants";
import { docRoutes, routeHref } from "../routes";

const repo = "https://github.com/kigster/sopsy";
const crate = "https://crates.io/crates/sopsy";
const here = Astro.url.pathname.replace(/\/$/, "");
---

<!-- Persisted across page transitions: only the content below it fades. -->
<header
  class="nav"
  transition:persist="site-nav"
  transition:name="site-nav"
  transition:animate="none"
>
  <div class="container nav__inner">
    <a href={import.meta.env.BASE_URL} class="brand" aria-label="sopsy home">
      <span class="glyph" aria-hidden="true">🔒</span>
      sopsy<small>v{SOPSY_VERSION}</small>
    </a>

    <nav class="nav__links" id="nav-menu" aria-label="Primary">
      {
        docRoutes.map((r) => (
          <a
            href={routeHref(r.slug)}
            aria-current={here === routeHref(r.slug) ? "page" : undefined}
          >
            {r.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__cta">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
        title="Toggle light / dark theme"
      >
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
        >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </button>
      <a class="nav__crate" href={crate} target="_blank" rel="noopener"
        >crates.io ↗</a
      >
      <a
        class="nav__gh"
        href={repo}
        target="_blank"
        rel="noopener"
        aria-label="sopsy on GitHub"
        title="sopsy on GitHub"
      >
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <button
        type="button"
        class="nav__burger"
        id="nav-burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg
          class="icon-menu"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg
        >
        <svg
          class="icon-close"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg
        >
      </button>
    </div>
  </div>
</header>
