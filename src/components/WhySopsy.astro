---
// The core argument: every row is a real task you can already do with raw
// sops/age — and the friction sopsy removes. Content drawn straight from the
// sopsy command reference and the "how encryption flows" docs.
const rows = [
  {
    task: "Bootstrap a repo",
    sops: "Hand-write <code>.sops.yaml</code> creation_rules, craft <code>.gitignore</code> rules, build <code>.env.example</code>, then encrypt by hand.",
    sopsy:
      "One idempotent command writes every file and seeds an encrypted <code>.env.encrypted</code> for you.",
    cmd: "sopsy init",
  },
  {
    task: "Get a hardware identity",
    sops: "Run <code>age-plugin-se keygen</code> or <code>age-plugin-yubikey --generate</code>, copy the public key, paste it into config without fat-fingering it.",
    sopsy:
      "The key is made in the best allowed store your machine has (Secure Enclave, YubiKey, keychain), printed prominently, and recorded in config automatically.",
    cmd: "sopsy init",
  },
  {
    task: "Onboard a teammate",
    sops: "Hand-edit <code>.sops.yaml</code>, run <code>sops updatekeys</code> on every file — and just trust on faith that the key really belongs to them.",
    sopsy:
      "The newcomer <code>join</code>s to record a <em>pending</em> request (no access yet); any active member <code>approve</code>s — vouching for the key, promoting it, and re-keying every secret in one step.",
    cmd: "sopsy join → sopsy approve",
  },
  {
    task: "Audit who has access",
    sops: "<code>git blame .sops.yaml</code> and hope the commit history tells the story of who let whom in.",
    sopsy:
      "Every member carries <code>requested_at</code>, <code>approved_at</code>, and <code>approved_by</code> — one command prints the whole audit trail as a table.",
    cmd: "sopsy recipient list",
  },
  {
    task: "Offboard a teammate",
    sops: "Hand-edit <code>.sops.yaml</code>, run <code>updatekeys</code> on each file, and miss that the data key never changed.",
    sopsy:
      "<code>recipient remove</code> re-wraps every file for the remaining members. The data key stays the same, so <code>rotate-data-key</code> re-encrypts under a new one. Then change the secret values: old ciphertext in git history still opens.",
    cmd: "sopsy recipient remove → sopsy rotate-data-key",
  },
  {
    task: "Swap your own key",
    sops: "Generate a new key, add it, remove the old one, re-key every file, and redo your approval by hand.",
    sopsy:
      "One command swaps your key under the same name and approval, and re-wraps every secret. <code>--new-data-key</code> also re-encrypts under a fresh data key.",
    cmd: "sopsy recipient rotate",
  },
  {
    task: "Edit an encrypted file",
    sops: "Pass <code>--input-type</code>/<code>--output-type</code> yourself — <code>.env.encrypted</code> has no extension sops recognizes.",
    sopsy:
      "File type is auto-detected (dotenv / yaml / json / binary); your <code>$EDITOR</code> just opens.",
    cmd: "sopsy edit",
  },
  {
    task: "Change one secret",
    sops: "Decrypt the whole file into an editor, find the line, retype the value, and hope nothing else changed.",
    sopsy:
      "Asks for the value with hidden input, or reads it from stdin, so it never lands in shell history. <code>unset</code> removes one.",
    cmd: "sopsy set API_KEY",
  },
  {
    task: "Run an app with secrets",
    sops: "Decrypt to a plaintext <code>.env</code> and remember to delete it, or wire up <code>sops exec-env</code> yourself.",
    sopsy:
      "Decrypts into one command's environment and writes nothing to disk. Several files merge; later ones win.",
    cmd: "sopsy run -- bin/dev",
  },
  {
    task: "Encrypt a file in one shot",
    sops: "Call <code>sops --encrypt</code> with the right <code>--input-type</code>, then redirect the output yourself and hope the artifact matches a creation rule.",
    sopsy:
      "<code>sopsy encrypt</code> writes a <code>.encrypted</code> artifact, auto-detecting the format — <code>.env</code>, <code>json</code>, <code>yaml</code>, <code>ini</code> — all encrypt <em>values only</em>; anything else as one blob.",
    cmd: "sopsy encrypt [file] -o file.encrypted",
  },
  {
    task: "Decrypt to stdout or a file",
    sops: "<code>sops --decrypt</code> with manual type flags, then redirect — easy to clobber the wrong file or leak plaintext to disk.",
    sopsy:
      "<code>sopsy decrypt</code> prints plaintext to stdout or writes it with <code>-o file</code>.",
    cmd: "sopsy decrypt file.encrypted [-o file]",
  },
  {
    task: "Know what's value-encryptable",
    sops: "Dig through docs to learn which formats support partial, values-only encryption versus whole-file.",
    sopsy:
      "<code>sopsy types</code> prints exactly which extensions value-encrypt (.env / .yaml / .json / .ini); everything else is encrypted as a single binary blob.",
    cmd: "sopsy types",
  },
  {
    task: "Guard CI against leaks",
    sops: "Roll your own grep for tracked plaintext and hope it catches every case.",
    sopsy:
      "Seven hygiene invariants, a clear pass/fail checklist, and a non-zero exit on any violation.",
    cmd: "sopsy check",
  },
  {
    task: "Give CI decryption access",
    sops: "Generate an age key on a laptop, paste the private half around, hand-edit <code>.sops.yaml</code>, and remember to delete the local copies.",
    sopsy:
      "A guided ceremony provisions a portable key, waits while you store <em>one</em> CI secret (<code>SOPS_AGE_KEY</code>), then deletes the local files and re-keys. A Linux runner with only <code>sops</code> installed can decrypt.",
    cmd: "sopsy recipient ci",
  },
  {
    task: "Diagnose a broken setup",
    sops: "Dig through <code>$PATH</code>, tool versions, Enclave and YubiKey status by hand.",
    sopsy:
      "A grouped, colorful report you can paste straight into a GitHub issue, including which key store <code>auto</code> would use. <code>sopsy deps</code> installs whatever is missing.",
    cmd: "sopsy doctor → sopsy deps",
  },
  {
    task: "Stay disaster-proof",
    sops: "Nothing reminds you to keep an offline recovery key. Lose the device, lose the secrets.",
    sopsy:
      "One guided ceremony generates a portable emergency key, waits while you store it offline, then deletes the local copy and registers it — and doctor and check nag until it exists.",
    cmd: "sopsy recipient break-glass",
  },
];
---

<section class="section" id="why">
  <div class="container">
    <div class="versus__head" data-reveal>
      <div>
        <p class="eyebrow eyebrow--lime">Why not just use sops?</p>
        <h2 class="section-title">
          You already can. sopsy removes the sixteen ways you can get it wrong.
        </h2>
      </div>
      <p class="section-lead">
        Everything here runs <strong>sops</strong> + <strong>age</strong> under the
        hood. The difference is the <strong>friction</strong> — the steps you have
        to remember, the flags you have to know, and the safety rails that aren't
        there until you build them.
      </p>
    </div>

    <div class="versus" data-reveal>
      <div class="versus__row">
        <div class="versus__cell versus__cell--head">
          <span class="versus__col">Task</span>
        </div>
        <div class="versus__cell versus__cell--head">
          <span class="versus__col versus__col--sops"
            ><span class="pill">raw</span> sops + age</span
          >
        </div>
        <div class="versus__cell versus__cell--head">
          <span class="versus__col versus__col--sopsy"
            ><span class="pill">with</span> sopsy</span
          >
        </div>
      </div>

      {
        rows.map((r) => (
          <div class="versus__row">
            <div class="versus__cell">
              <span class="versus__task">{r.task}</span>
            </div>
            <div class="versus__cell">
              <p class="versus__sops">
                <>
                  <span class="x">✕</span>
                  <Fragment set:html={r.sops} />
                </>
              </p>
            </div>
            <div class="versus__cell versus__cell--sopsy">
              <p class="versus__sopsy">
                <>
                  <span class="c">→</span>
                  <Fragment set:html={r.sopsy} />
                </>
                <>
                  <br />
                  <br />
                  <code>{r.cmd}</code>
                </>
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="versus__foot" data-reveal>
      <span class="lime">●</span>
      <b>Net effect:</b> the same battle-tested crypto, minus the foot-guns — every
      interactive prompt also has a flag, so a human at a terminal and an unattended
      CI job run the exact same tool.
    </p>
  </div>
</section>
