---
const items = [
  "SOPS encryption engine",
  "age cryptography",
  "age-plugin-se",
  "age-plugin-yubikey",
  "Secure Enclave",
  "YubiKey PIV",
  "Touch ID gated",
  "Key-store policy",
  "Git-committed ciphertext",
  "Zero plaintext leaks",
  "Scriptable in CI",
  "sopsy run: no plaintext on disk",
  "Self-service onboarding",
  "Built-in audit trail",
  "Tamper-evident config",
];
// Duplicate the track so the loop is seamless.
const track = [...items, ...items];
---

<!-- The band stays full-bleed; the scrolling text is capped in .marquee__viewport. -->
<div class="marquee" aria-hidden="true">
  <div class="marquee__viewport">
    <div class="marquee__track">
      {
        track.map((t) => (
          <span class="marquee__item">
            <span class="marquee__sep">✦</span>
            <b>{t}</b>
          </span>
        ))
      }
    </div>
  </div>
</div>
